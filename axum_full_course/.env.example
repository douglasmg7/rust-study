# Every module listens on its own default port (3000 + module number, e.g.
# module 07 runs on 3007) so you can run several modules side by side.
# This variable overrides a module's default port when it is set.
AXUM_PORT=3001

# Log filter for tracing (used from module 37 on).
# Examples: info, debug, module_name=debug,tower-http=off
RUST_LOG=info

# Used by the database modules (14-17, 21) and the capstones.
# Modules 15 and 16 keep their tables in their own schema (DB_SCHEMA, default module15 / module16).
# Start the matching services first: `docker compose up postgres redis`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/axum_course
REDIS_URL=redis://localhost:6379
# Module 16 only: SQLite file and MongoDB (both optional).
SQLITE_URL=sqlite://module16.sqlite
MONGODB_URL=mongodb://localhost:27017

# Used by the authentication modules (19-23) and the capstones.
JWT_SECRET=change-this-secret-in-production-use-32-plus-chars
# Module 20: set to the OLD secret while rotating keys so existing tokens keep working.
# JWT_PREVIOUS_SECRET=
# Module 21: cookie signing/encryption key (64+ bytes in production), Secure flag, session store.
COOKIE_KEY=change-this-cookie-key-it-must-be-at-least-64-bytes-long-for-axum-extra
COOKIE_SECURE=0
SESSION_STORE=memory
# Module 19: argon2 cost (OWASP minimum is 19 MiB, 2 passes, 1 lane).
ARGON2_M_KIB=19456
ARGON2_T=2
ARGON2_P=1
# Module 23: hardening.
# CORS_ORIGINS=https://app.example.com,https://*.example.com
HSTS=0
UNSAFE_SQL_DEMO=0
API_KEY=dev-api-key-change-me
# Module 27: where uploads are stored, the per-file limit, and the storage backend (disk).
# UPLOAD_DIR=./uploads-module27
# MAX_UPLOAD_BYTES=10485760
# STORAGE=disk
# Module 28: how long an unfinished resumable upload lives before the sweeper deletes it.
# UPLOAD_TTL_SECS=3600
# Module 29: directory served by the Range-download module.
# FILES_DIR=./files-module29
# Module 30: media folder, HLS cache and the key that signs stream URLs (16+ characters).
# MEDIA_DIR=./media-module30
# CACHE_DIR=./cache-module30
MEDIA_SECRET=change-this-media-secret
# Module 31: graceful shutdown window, and an optional RabbitMQ broker.
# DRAIN_SECS=10
# AMQP_URL=amqp://guest:guest@127.0.0.1:5672/%2f
# Module 32: origin of the service to call and proxy to, webhook secret(s), trusted proxy IPs or CIDRs.
# UPSTREAM=http://127.0.0.1:3032
WEBHOOK_SECRET=whsec_demo_secret
# TRUSTED_PROXIES=127.0.0.1,::1
# Module 36: Postgres used by the database tests (needs a role that may CREATE DATABASE); QUOTE_URL points /quote elsewhere.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/axum_course
# QUOTE_URL=http://127.0.0.1:3036
# Module 37: LOG_FORMAT=json for JSON logs; an OTLP/HTTP collector endpoint turns trace export on.
# LOG_FORMAT=json
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=module-37-observability
# Module 38: layered config. APP__SECTION__KEY overrides config/*.toml; APP_ENV picks the environment file.
# APP_ENV=development
# APP__SERVER__PORT=3038
# APP__FEATURES__NEW_CHECKOUT=true
# APP__AUTH__JWT_SECRET=replace-with-32-or-more-random-characters
# APP__AUTH__JWT_SECRET_FILE=/run/secrets/jwt
# Module 40: size of the simulated database pool.
# POOL_SIZE=10
# Module 41: socket handoff (set by systemd or a supervisor, not by hand)
# LISTEN_FDS=1
# LISTEN_PID=<pid of the server process>
# Module 42: TLS and the HTTP redirect port
# TLS_CERT=/etc/tls/cert.pem
# TLS_KEY=/etc/tls/key.pem
# AXUM_HTTP_PORT=3142
# Module 43: container settings (BIND must be 0.0.0.0 inside a container)
# BIND=0.0.0.0
# GIT_SHA=dev
# POSTGRES_PASSWORD=change-me
# Module 44 uses only AXUM_PORT (default 3044).
